# Copy to .env and fill in. Never commit .env.

# LiveKit Cloud: cloud.livekit.io > your project > Settings > API keys
# The URL is the wss:// one (`lk project list` prints it), not the dashboard link.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ID printed by `lk sip outbound list` (starts with ST_)
SIP_OUTBOUND_TRUNK_ID=
# Your Twilio number in E.164, like +18055550123. Every call goes out from it.
CALLER_NUMBER=

# Speech-to-text, LLM, text-to-speech
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Optional. Change only if this model gets retired.
LLM_MODEL=gpt-4.1-mini
